---
import { type Lang, t } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const SPIRAL =
  'M100 0 A100 100 0 0 1 0 100 A61.8 61.8 0 0 1 -61.8 38.2 A38.2 38.2 0 0 1 -23.61 0 A23.61 23.61 0 0 1 0 23.61 A14.59 14.59 0 0 1 -14.59 38.2';
---

<section class="hero" id="top" data-hero>
  <canvas class="hero-gl" data-hero-gl aria-hidden="true"></canvas>

  <!-- shown until WebGL is ready (and if it is unavailable) -->
  <svg class="hero-fallback" viewBox="-70 -8 176 116" fill="none" aria-hidden="true">
    <path d={SPIRAL} stroke="#63A6A0" stroke-width="2.8" stroke-linecap="round" pathLength="1"></path>
  </svg>

  <div class="container hero-inner">
    <p class="kicker hero-in" style="--d:0.1s">{t(lang, 'hero.kicker')}</p>
    <h1 class="hero-title">
      <span class="line"><span class="hero-in" style="--d:0.2s">{t(lang, 'hero.title.a')}</span></span>
      <span class="line accent"><span class="hero-in" style="--d:0.32s">{t(lang, 'hero.title.b')}</span></span>
    </h1>
    <p class="hero-text hero-in" style="--d:0.5s">{t(lang, 'hero.text')}</p>
    <div class="hero-actions hero-in" style="--d:0.62s">
      <a class="btn btn-primary" href="#contact">{t(lang, 'hero.cta')} <span class="arrow">→</span></a>
      <a class="btn btn-outline" href="#services">{t(lang, 'hero.cta.secondary')}</a>
    </div>
  </div>

  <a class="hero-scroll" href="#services" aria-label={lang === 'en' ? 'Scroll' : 'Défiler'}><span></span></a>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-gl]');
  if (hero && canvas) {
    // Vera freeze: 3D off below 768px — static SVG still; IO pause already in hero3d
    const mq = window.matchMedia('(min-width: 768px)');
    const reducedMq = window.matchMedia('(prefers-reduced-motion: reduce)');
    type Hero3DHandle = { destroy: () => void };
    let instance: Hero3DHandle | null = null;
    let booting = false;

    const teardown = () => {
      if (instance) {
        instance.destroy();
        instance = null;
      }
      hero.classList.remove('gl-on');
    };

    const boot = () => {
      if (booting || instance || !mq.matches || reducedMq.matches) return;
      booting = true;
      import('../scripts/hero3d')
        .then(({ createHero3D }) => {
          if (!mq.matches || reducedMq.matches) {
            booting = false;
            return;
          }
          teardown();
          instance = createHero3D(canvas, hero);
          requestAnimationFrame(() => hero.classList.add('gl-on'));
        })
        .catch(() => {
          /* SVG spiral stays */
        })
        .finally(() => {
          booting = false;
        });
    };

    const onMqChange = () => {
      if (!mq.matches) teardown();
      else if (!reducedMq.matches) boot();
    };

    if (mq.matches && !reducedMq.matches) {
      'requestIdleCallback' in window ? requestIdleCallback(boot, { timeout: 1200 }) : setTimeout(boot, 300);
      // Soft nit: tear down / re-boot when crossing the 768px breakpoint
      mq.addEventListener('change', onMqChange);
    }
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: #14333b;
    color: #f2efe6;
    padding-block: calc(var(--nav-h) + 30px) 80px;
  }

  /* soft radial behind spiral — presence without more GPU */
  .hero::after {
    content: '';
    position: absolute;
    right: 2vw;
    top: 50%;
    width: min(58vw, 780px);
    height: min(58vw, 780px);
    transform: translateY(-50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(99, 166, 160, 0.18) 0%, transparent 68%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-gl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.4s ease;
    z-index: 1;
  }

  .hero.gl-on .hero-gl {
    opacity: 1;
  }

  .hero-fallback {
    position: absolute;
    right: 4vw;
    top: 50%;
    width: min(52vw, 720px);
    transform: translateY(-50%);
    opacity: 0.72;
    transition: opacity 1s ease;
    z-index: 1;
  }

  .hero-fallback path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: hero-draw 2.6s 0.3s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  .hero.gl-on .hero-fallback {
    opacity: 0;
  }

  @keyframes hero-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .hero-inner {
    position: relative;
    z-index: 2;
  }

  /* left wash so type pops over spiral */
  .hero-inner::before {
    content: '';
    position: absolute;
    inset: -8% -12% -8% -18%;
    background: linear-gradient(90deg, rgba(20, 51, 59, 0.55), transparent 55%);
    pointer-events: none;
    z-index: -1;
  }

  .hero .kicker {
    color: #63a6a0;
    letter-spacing: 0.18em; /* +2% vs global 0.16em — brand bar */
  }

  .hero .kicker::before {
    background: #63a6a0;
  }

  .hero-title {
    margin-top: 22px;
    max-width: 12ch;
    color: #f2efe6;
    font-weight: 400;
    font-size: clamp(3.4rem, 8.2vw, 7.2rem);
    line-height: 0.96;
    letter-spacing: -0.02em;
  }

  .hero-title .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .hero-title .line > span {
    display: inline-block;
  }

  .hero-title .accent {
    color: #7bb8b2;
    font-weight: 500;
  }

  .hero-text {
    margin-top: 26px;
    max-width: 44ch;
    font-size: clamp(1.08rem, 1.55vw, 1.28rem);
    color: rgba(242, 239, 230, 0.88);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 40px;
  }

  /* primary dominates — paper fill on deep ground */
  .hero .btn-primary {
    padding: 16px 28px;
    min-width: 220px;
    color: #14333b;
    background: #f2efe6;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.28);
  }

  .hero .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 14px 44px rgba(0, 0, 0, 0.34);
  }

  .btn-outline {
    color: #f2efe6;
    border: 1px solid rgba(242, 239, 230, 0.22);
  }

  .btn-outline:hover {
    background: rgba(242, 239, 230, 0.1);
  }

  /* entrance — snappier: rise 12px / ≤900ms */
  .hero-in {
    animation: hero-rise 0.9s var(--d) cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-play-state: paused;
  }

  :global(html:not(.splash-lock)) .hero-in {
    animation-play-state: running;
  }

  .hero-title .hero-in {
    animation-name: hero-line;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @keyframes hero-line {
    from {
      transform: translateY(105%);
    }
  }

  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: 26px;
    width: 1px;
    height: 56px;
    background: rgba(242, 239, 230, 0.18);
    overflow: hidden;
    z-index: 2;
  }

  .hero-scroll span {
    position: absolute;
    left: 0;
    width: 1px;
    height: 22px;
    background: #63a6a0;
    animation: hero-scroll 2s ease-in-out infinite;
  }

  @keyframes hero-scroll {
    from {
      top: -22px;
    }
    to {
      top: 56px;
    }
  }

  @media (max-width: 760px) {
    .hero {
      align-items: flex-end;
    }
    .hero.gl-on .hero-gl {
      opacity: 0.55;
    }
    .hero-fallback {
      width: 90vw;
      top: 28%;
      right: -10vw;
    }
    .hero::after {
      width: 90vw;
      height: 90vw;
      top: 28%;
      right: -10vw;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-in,
    .hero-fallback path,
    .hero-scroll span {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
